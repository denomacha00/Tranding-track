# Keep the Docker build context small and reproducible.
# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
**/*.tsbuildinfo

# Python
**/__pycache__/
**/*.py[cod]
backend/.venv/
backend/venv/
**/*.egg-info/
**/.pytest_cache/
backend/_alembic_tmp/

# Secrets & local DB (set env vars in Railway instead; never bake secrets in)
**/.env
**/*.env
!**/env.example
**/*.db
**/*.sqlite
**/*.sqlite3

# Editor / OS / scratch
.git/
.vscode/
.idea/
.DS_Store
Thumbs.db
.kilo/
.techword/
COMMIT_MSG.tmp
*.log
